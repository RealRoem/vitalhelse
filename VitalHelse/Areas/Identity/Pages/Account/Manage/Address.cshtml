@page
@model AddressModel

@{
    ViewBag.Title = "Leveringsadresse"; 
    ViewData["ActivePage"] = ManageNavPages.Address;
}

<partial name="_StatusMessage" for="StatusMessage" /> 
<div class="account-container">
    <div class="account-card">
        <form id="form-group" method="post" class="account-form">
            <div class="form-group">
                <label asp-for="Input.Address">Adresse</label>
                <input asp-for="Input.Address" placeholder="Adresse" />
                <span asp-validation-for="Input.Address" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.PostalCode">Postnummer</label>
                <input id="postalcode" asp-for="Input.PostalCode" placeholder="Postnummer" />
                <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="Input.PostalPlace">Poststed</label>
                <input asp-for="Input.PostalPlace" id="city" placeholder="Poststed" readonly class="form-control" />
            </div>
          
            <button id="registerSubmit" type="submit" class="btn-submit">Lagre endringer</button>
        </form>
        
    </div>

</div>

@section Scripts {
    <script src="~/js/utils/postLookup.js"></script>
    <partial name="_ValidationScriptsPartial" />
}

