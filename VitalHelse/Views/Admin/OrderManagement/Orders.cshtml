@model List<VitalHelse.Models.Order>

@{
    ViewBag.Title = "Ordre";
    Layout = "_AdminLayout";
}


<h2 class="mb-4">Alle ordre</h2>

<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>Ordre #</th>
        <th>Dato</th>
        <th>Kunde</th>
        <th>Adresse</th>
        <th>Leveringsmetode</th>
        <th>Totalpris</th>
        <th>Produkter</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var o in Model)
    {
        <tr>
            <td>@o.OrderId</td>

            <td>@o.OrderDate?.ToString("dd.MM.yyyy HH:mm")</td>

            <td>
                @o.AspNetUsers?.Email
            </td>

            <td>
                @o.ShippingFirstName @o.ShippingLastName <br />
                @o.ShippingStreet <br />
                @o.ShippingPostalCode @o.ShippingCity <br />
                @o.ShippingPhoneNumber
            </td>

            <td>
                <strong>@o.ShippingMethodName</strong><br />
                Pris: @o.ShippingPrice.ToString("0.00") kr
            </td>

            <td>
                <strong>@o.TotalCost.ToString("0.00") kr</strong>
            </td>

            <td>
                <ul>
                    @foreach (var p in o.OrderProducts)
                    {
                        <li>
                            @p.Product.ProductName × @p.Quantity
                        </li>
                    }
                </ul>
            </td>
        </tr>
    }
    </tbody>
</table>