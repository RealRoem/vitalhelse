@using VitalHelse.Helpers
@model IEnumerable<VitalHelse.Models.Product>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
bool isAuthenticated = ViewData["IsAuthenticated"] as bool? ?? false;
bool isAdminView = ViewData["IsAdminView"] as bool? ?? false;
}

@{
    var authorized = (await AuthorizationService.AuthorizeAsync(User, "Privileged")).Succeeded;
}

@if (Model != null && Model.Any())
{ @Html.AntiForgeryToken()
<div class="product-grid">
    @foreach (var product in Model)
    {
    var isHidden = product.LabelDescription?.ToLower().Contains("hidden") ?? false;

    decimal? original = product.ProductPriceInVAT;
    decimal? campaign = product.ProductCampaignPrice;
    decimal? businessPrice = product.ProductPriceExVAT;
    decimal businessCampaign = 0;
    int discountPercent = 0;

    if (User.IsInRole("BusinessCustomer") && campaign.HasValue && businessPrice.HasValue)
    {
        decimal vatFactor = businessPrice.Value / original.Value;
        businessCampaign = campaign.Value * vatFactor;
        discountPercent = (int)Math.Round((1 - (campaign.Value / original.Value)) * 100);
    }

    else if (campaign.HasValue && original.HasValue && original.Value > 0)
    {
        discountPercent = (int)Math.Round((1 - (campaign.Value / original.Value)) * 100);
    }

    <div class="product-card @(isHidden ? "hidden-product" : "")">

        <!-- Favorittknapp -->
        <button type="button"
                class="heart-btn @(product.IsFavorite ? "active" : "")"
                data-id="@product.ProductId"
                title="Legg til eller fjern favoritt">
            <i class="@(product.IsFavorite ? "fa-solid" : "fa-regular") fa-heart"></i>
        </button>

        <!-- Rabattsirkel -->
        @if (campaign.HasValue)
        {
        <div class="discount-circle">-@discountPercent%</div>
        }

        <!-- Klikkbart bilde -->
        <a href="@SlugHelper.BuildProductPath(product)" class="product-img-wrapper">
            <img src="@Url.Content(product.ProductPictures.FirstOrDefault()?.PicturePath ?? "~/images/products/default.png")"
                 alt="@product.ProductName"
                 class="product-img" />
        </a>

        <!-- Navn -->
        <h5 class="product-name">@product.ProductName</h5>

        <!-- Beskrivelse -->
        <p class="product-desc">@product.ProductDescription</p>

        <!-- Pris -->
        <div class="price">
            @if ((User.IsInRole("BusinessCustomer") || authorized) && businessCampaign != 0 && businessPrice.HasValue)
            {
                <span class="price-new price-incvat">@campaign.Value.ToString("0.00") kr</span>
                <span class="price-old price-incvat">@original.Value.ToString("0.00") kr</span>
                <span class="price-new price-exvat">@businessCampaign.ToString("0.00") kr</span>
                <span class="price-old price-exvat">@businessPrice.Value.ToString("0.00") kr</span>
            }
            else if ((User.IsInRole("BusinessCustomer") || authorized) && businessPrice.HasValue)
            {
                <span class="price-regular price-exvat">@businessPrice.Value.ToString("0.00") kr</span>
                <span class="price-regular price-incvat">@original.Value.ToString("0.00") kr</span>
            }
            else if (campaign.HasValue)
            {
                <span class="price-new">@campaign.Value.ToString("0.00") kr</span>
                <span class="price-old">@original.Value.ToString("0.00") kr</span>
            }
            else
            {
                <span class="price-regular">@original.Value.ToString("0.00") kr</span>
            }
        </div>
        <!-- Kjøp knapp -->
        <button type="button" class="btn-submit" onclick="AddToCart(@product.ProductId)"> Kjøp </button>
    </div>
    }
</div>
}
else
{
<p class="text-muted text-center mt-4">Ingen produkter funnet.</p>
}


<script>
    (function () {
        const isAuthenticated = @( (ViewData["IsAuthenticated"] as bool? ?? false).ToString().ToLower() );

        const grid = document.currentScript.previousElementSibling;

        grid.addEventListener('click', async (e) => {
            const btn = e.target.closest('.heart-btn');
            if (!btn) return;

            if (!isAuthenticated) {
                alert("Du må være logget inn for å legge til favoritter ❤️");
                return;
            }

            const id = btn.dataset.id;
            const res = await fetch('/Favorites/ToggleFavorite', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${encodeURIComponent(id)}`
            });

            if (!res.ok) return;

            let isFav = null;
            try { const data = await res.json(); isFav = !!data.isFavorite; } catch {}

            if (isFav === null) isFav = !btn.classList.contains('active');


            btn.classList.toggle('active', isFav);
            const icon = btn.querySelector('i');
            icon.classList.toggle('fa-regular', !isFav);
            icon.classList.toggle('fa-solid', isFav);

            if (window.location.pathname.startsWith('/favoritter') && !isFav) {
                const card = btn.closest('.product-card');
                card.style.transition = 'opacity .3s ease, transform .25s ease';
                card.style.opacity = '0';
                card.style.transform = 'scale(0.96)';
                setTimeout(() => card.remove(), 300);
            }
        });
    })();
</script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const productCards = document.querySelectorAll('.product-card');
        productCards.forEach(card => {
            card.addEventListener('click', function(e) {
                if(!e.target.closest("button")){
                    const url = this.dataset.url;
                    if(url){
                        window.location.href = url;
                    }
                }
            });
        });
    });
</script>

<script>
    async function AddToCart(productId){
        const isAuthenticated = @( (ViewData["IsAuthenticated"] as bool? ?? false).ToString().ToLower() );
        const quantityElement = document.getElementById(`quantity-${productId}`);
        const quantity = quantityElement ? parseInt(quantityElement.value, 10) || 1:1;

        // Saves antiforgerytoken to protect against CSRF-attacks
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        const formData = new FormData();
        formData.append("id", productId);
        formData.append("quantity", "1");

        // Fetch the delete function from the controller
        //const response = await fetch(`/ShoppingCart/AddToCart/?id=${productId}&quantity=${quantity}`, {
        const response = await fetch("/ShoppingCart/AddToCart", {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        });

        // Prints the error message if bad request is returned, and keeps it there for 3 seconds
        if (!response.ok) {
            const msg = await response.text();
            document.getElementById("error-box").innerText = msg;
            setTimeout(() => document.getElementById("error-box").innerText = "", 3000);
        } else {
            if (!isAuthenticated) {
