@*
  Fil: Views/Shared/_AdminLayout.cshtml
  Brukes kun for admin-sider (Dashboard, Produkter, Kategorier, osv.)
*@
<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VitalHelse Admin</title>
    <link rel="icon" type="image/png" href="~/leaf_logo.svg" />
    
    <!-- 1. Core styles -->
    <link rel="stylesheet" href="~/css/pages/site.css" asp-append-version="true" />

    <!-- 2. Admin-specific (overrides site.css) -->
    <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />

    <!-- 3. Component-level -->
    <link rel="stylesheet" href="~/css/components/productgrid.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/listview.css" asp-append-version="true"/>

    <!-- 4. Page-level -->
    <link rel="stylesheet" href="~/css/admin/discount.css" />
    <link rel="stylesheet" href="~/css/pages/adduser.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/adminStaffPage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/editroles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/homeCarousel.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/homePageManagement.css" asp-append-version="true"/>

    <link rel="stylesheet" href="~/css/pages/adminStockCount.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/excelExportButtonStockCountFilter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/sideBarFilter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>

<body class="admin-mode">
<div class="admin-layout">
    <aside class="sidebar">
        <a asp-controller="Home" asp-action="Index">
            <img class="vital-logo" src="~/images/logo/logo.svg" alt="VitalHelse">
        </a>
        <nav>
            <a asp-controller="Admin" asp-action="Dashboard"
               class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">Dashboard</a>
            <a asp-controller="Admin" asp-action="Products"
               class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "active" : "")">Produkter</a>
            <a asp-controller="Admin" asp-action="Categories"
               class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Categories" ? "active" : "")">Kategorier</a>
            <a asp-controller="HomePageManagement" asp-action="Index"
               class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Banners" ? "active" : "")">Bannere</a>
            <a asp-controller="DiscountCode" asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Rabattkoder" ? "active" : "")">Rabattkoder</a>
            <a asp-controller="CategoryDiscount" asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Rabattsatser" ? "active" : "")">Rabattsatser</a>
            <a asp-controller="Campaign" asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Kampanjer" ? "active" : "")">Kampanjer</a>
            <a asp-controller="ShippingManagement" asp-action="Shipping"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "ShippingManagement" ? "active" : "")">Frakt</a>
            <a asp-controller="OrderManagement" asp-action="Orders"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "OrderManagement" ? "active" : "")">Ordre</a>
            <a asp-controller="UserManagement" asp-action="Index"
               class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Banners" ? "active" : "")">Ansatte</a>
        </nav>

    </aside>

    <main class="content">
        <header class="topbar">
            <h1>@ViewData["Title"]</h1>
            <span class="admin-user">Admin ⚙️ Vitalhelse</span>
        </header>

        <section class="admin-body">
            @RenderBody()
        </section>
    </main>
</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/js/temp/sidebarFilter.js"></script>

@RenderSection("Scripts", required: false)
</body>
</html>