@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService


@inject VitalHelse.Data.ApplicationDbContext _db;


@{
    var topCategories = _db.Categories
        .Where(c => c.ParentCategoryId == null)
        .OrderBy(c => c.CategoryName)
        .ToList();
}

@{
    var authorized = (await AuthorizationService.AuthorizeAsync(User, "Privileged")).Succeeded;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - VitalHelse</title>
    <script type="importmap"></script>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    
    <link rel="icon" type="image/png" href="~/leaf_logo.svg" />
    
    <link rel="stylesheet" href="~/css/pages/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/HomePage.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/layout.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/search.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/navbar.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/productpage.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/account.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/productgrid.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/checkout.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components/product-form-images.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/product-form-dropdown.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/product-form-tags.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/sideBarFilter.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/homeCarousel.css" asp-append-version="true"/>

    <link rel="stylesheet" href="~/VitalHelse.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;500&family=Raleway:wght@300;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Cormorant+Garamond:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@100..900&display=swap" rel="stylesheet">
    </head>
<body>
<header>
    <nav id="navbar" class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <div class="navbar-top align-items-center">
                <!-- Venstre: søk -->
                <form class="search-form" asp-controller="Search" asp-action="Search" method="get">
                    <div class="search-container position-relative">
                        <input
                            id="searchInput"                     
                        name="query"                          
                        type="search"
                        class="search-input form-control"
                        placeholder="Søk etter..."
                        autocomplete="off"
                        aria-label="Søk"
                        />
                        <button type="submit" class="search-btn" aria-label="Søk">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </button>
                        <!-- beholder nøyaktig ID som JS bruker -->
                        <div id="searchSuggestions" class="search-suggestions"></div>
                    </div>
                </form>

                <!-- Midten: logo -->
                <a asp-controller="Home" asp-action="Index">
                    <img class="vital-logo" src="~/images/logo/logo.svg" alt="VitalHelse">
                </a>
                
                <!-- if admin or staff, the add product link shows-->
                <!--@if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                    {
                        <a class="addproduct" asp-controller="AdminProduct" asp-action="AddProduct">Legg til et produkt</a>
                    }  -->
                
                <!-- Høyre: ikoner -->
                <div class="nav-icons">
                    <a href="/favoritter"
                       class="icon-link @(Context.Request.Path.StartsWithSegments("/favoritter") ? "active" : "")"
                       title="Mine favoritter">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"></path>
                        </svg>
                    </a>
                    
                    @if(User.Identity.IsAuthenticated){
                      <a href="/identity/account/manage/RedirectAfterLogin" class="icon-link" title="Min side">
                          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none"
                               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="7" r="4"></circle>
                              <path d="M5.5 20a6.5 6.5 0 0 1 13 0"></path>
                          </svg>
                      </a> 
                    }
                    else
                    {
                        <a href="/Identity/Account/Login?returnUrl=/Identity/Account/Manage/RedirectAfterLogin" class="icon-link" title="Min side">
                            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="7" r="4"></circle>
                                <path d="M5.5 20a6.5 6.5 0 0 1 13 0"></path>
                            </svg>
                        </a>  
                    }
                    
                    <a asp-controller="Checkout" asp-action="Index" class="icon-link" title="Handlevogn" style="position: relative">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        
                        <span id="cart-count">
                            0
                        </span>
                    </a>
                    @if (User.IsInRole("BusinessCustomer") || authorized)
                    {
                        <div class="vat-toggle">
                            <span class="vat-label vat-label-inc">MVA</span>

                            <label class="switch">
                                <input type="checkbox" id="myToggle">
                                <span class="slider"></span>
                            </label>

                            <span class="vat-label vat-label-ex">Eks. MVA</span>
                        </div>

                    }

                </div>
            </div>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav">
                    <!--<li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Hjem</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privat</a>
                    </li>-->
                    
                    @foreach (var cat in topCategories) {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["categoryPath"]?.ToString()?.ToLower() == cat.CategoryName.ToLower() ? "active" : "")"
                               href="/produkt/@cat.CategoryName">
                                @cat.CategoryName
                            </a>
                        </li>
                    }
                    
                    @if (User.IsInRole("Admin")) {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Admin</a>
                        </li>
                    }
                    
                    <!--<partial name="_LoginPartial"/>-->
                </ul>
                
            </div>
        </div>
    </nav>
</header>
<div class="main-container container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2025 - VitalHelse - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/components/searchSuggestions.js" asp-append-version="true"></script>
<script src="~/js/components/navbarAnimation.js" asp-append-version="true"></script>
<script src="~/js/temp/sidebarFilter.js" asp-append-version="true"></script>
<script src="~/js/components/cartCount.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>