@model VitalHelse.Models.ProductDetailViewModel
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{ bool isAuthenticated = ViewData["IsAuthenticated"] as bool? ?? false; }

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}
@*<div id="auth-state" data-logged-in="@(ViewData["IsAuthenticated"]?.ToString().ToLower() ?? "false")"></div>*@

@{
    var authorized = (await AuthorizationService.AuthorizeAsync(User, "Privileged")).Succeeded;
}

<div style="margin-top: 1rem">
    
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">HJEM</a></li>

            @if (!string.IsNullOrEmpty(Model.CategoryPath))
            {
                var parts = Model.CategoryPath.Split('/');
                var path = "";
                foreach (var part in parts)
                {
                    path += "/" + part;
                    <li class="breadcrumb-item">
                        <a href="@("/produkt" + @path)">@part.ToUpper()</a>
                    </li>
                }
            }
            <li class="breadcrumb-item active" aria-current="page"> @Model.CurrentProduct.ProductName</li>
        </ol>
    </nav>

    <div class="row" id="product-page">
        <div class="col-12 col-md-6">
            @if (Model.CurrentProduct.ProductPictures.Any())
            {
                <div id="pictures" class="carousel slide position-relative" data-bs-ride="carousel">
                    <button type="button"
                            class="heart-btn @(Model.IsFavorite ? "active" : "")"
                            data-id="@Model.CurrentProduct.ProductId"
                            title="Legg til eller fjern som favoritt">
                        <i class="@(Model.IsFavorite ? "fa-solid" : "fa-regular") fa-heart"></i>
                    </button>

                    <div class="carousel-indicators">
                        @for (int i = 0; i < Model.CurrentProduct.ProductPictures.Count; i++)
                        {
                            <button type="button" data-bs-target="#pictures" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="slide@(i + 1)"> </button>
                        }
                    </div>
                    <div class="carousel-inner">
                        @{ int index = 0; }
                        @foreach (var pic in Model.CurrentProduct.ProductPictures)
                        {
                            <div class="carousel-item @(index == 0 ? "active" : "")">
                                <img src="@pic.PicturePath" alt="@Model.CurrentProduct.ProductName" class="d-block w-100">
                            </div>
                            index++;
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#pictures" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#pictures" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            }
            else
            {
                <p>No picture found</p>
            }
        </div>

        <div class="col ms-4">
            <h1 class="product-title mt-4"> @Model.CurrentProduct.ProductName</h1>
            <!-- Pris -->
            <div class="price price-product-page">
                @{
                    decimal? original = @Model.CurrentProduct.ProductPriceInVAT;
                    decimal? campaign = @Model.CurrentProduct.ProductCampaignPrice;
                    decimal? businessPrice = @Model.CurrentProduct.ProductPriceExVAT;
                    decimal businessCampaign = 0;

                    int discountPercent = 0;

                    if (User.IsInRole("BusinessCustomer") && campaign.HasValue && businessPrice.HasValue)
                    {
                        decimal vatFactor = businessPrice.Value / original.Value;
                        businessCampaign = campaign.Value * vatFactor;
                    }

                    else if (campaign.HasValue && original.HasValue && original.Value > 0)
                    {
                        discountPercent = (int)Math.Round((1 - (campaign.Value / original.Value)) * 100);
                    }
                }
                
                @if ((User.IsInRole("BusinessCustomer") || authorized) && businessCampaign != 0 && businessPrice.HasValue)
                {
                    <h4 class="price-new price-exvat">@businessCampaign.ToString("0.00") kr</h4>
                    <span class="price-old price-exvat">@businessPrice.Value.ToString("0.00") kr</span>
                    <h4 class="price-new price-incvat">@campaign.Value.ToString("0.00") kr</h4>
                    <span class="price-old price-incvat">@original.Value.ToString("0.00") kr</span>
                }
                else if ((User.IsInRole("BusinessCustomer") || authorized) && businessPrice.HasValue)
                {
                    <h4 class="price-regular price-exvat">@businessPrice.Value.ToString("0.00") kr</h4>
                    <h4 class="price-regular price-incvat">@original.Value.ToString("0.00") kr</h4>
                }

                else if (campaign.HasValue)
                {
                    <h4 class="price-new">@campaign.Value.ToString("0.00") kr</h4>
                    <span class="price-old">@original.Value.ToString("0.00") kr</span>
                }
                else
                {
                    <h4 class="price-regular">@original.Value.ToString("0.00") kr</h4>
                }
                
            </div>
            <p class="mt-3"> @Model.CurrentProduct.ProductDescription</p>

            <div class="row align-items-center">
                @Html.AntiForgeryToken()
                <!-- Quantity -->
                <div class="col-auto">
                    <div class="input-group change-quantity">
                        <button onclick="DecreaseQuantity(@Model.CurrentProduct.ProductId, @(Model.CurrentProduct.ProductCampaignPrice ?? Model.CurrentProduct.ProductPriceInVAT))" class="btn btn-outline-secondary" type="button">&minus;</button>
                        <input id="quantity-@Model.CurrentProduct.ProductId" class="form-control text-center" style="max-width:60px" value=" 1" onchange="UpdateQuantityLocal(@Model.CurrentProduct.ProductId)">
                        <button onclick="AddQuantity(@Model.CurrentProduct.ProductId, @(Model.CurrentProduct.ProductCampaignPrice ?? Model.CurrentProduct.ProductPriceInVAT))" class="btn btn-outline-secondary" type="button">+</button>
                    </div>
                </div>


                <!-- Add to shopping cart -->
                <div class="text-center col">
                    <button type="button" class="btn-submit w-100" onclick="AddToCart(@Model.CurrentProduct.ProductId)"> Legg i handlekurv </button>
                    <div id="error-box" style="color:red; font-weight:bold; margin-top:10px;"></div>
                </div>

                <div class="accordion accordion-flush mt-4" id="productAccordion">
                    <div class="accordion-item border-bottom">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed text-uppercase" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseThree">
                                BRUK
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <p> @Model.CurrentProduct.ProductInstructions</p>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border-bottom">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed text-uppercase" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseThree">
                                INGREDIENSER
                            </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <p> @Model.CurrentProduct.ProductIngredients</p>
                            </div>
                        </div>
                    </div>
                    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                    {
                        <a class="editproduct" asp-controller="AdminProduct" asp-action="EditProduct" asp-route-id="@Model.CurrentProduct.ProductId">Rediger produkt</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div id="recommendations-container"></div>

