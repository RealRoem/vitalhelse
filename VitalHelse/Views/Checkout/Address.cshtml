@using VitalHelse.Models.Enums
@model VitalHelse.Models.UserAddressViewModel

@{
    ViewBag.Title = "Personalia";
    Layout = "_CheckoutLayout";
    var hasAddresses = Model.Existing != null && Model.Existing.Any(); // Checks if list with addresses exists and if there exists at least 1 element in there
    var showForm = !ViewData.ModelState.IsValid; // Checks if the model is not valid, show form if invalid (true), hide if valid (false)
}

<div id="address-page" data-has-addresses="@(hasAddresses.ToString().ToLower())">
    @if (hasAddresses)
    {
        <div id="address-list-wrapper" style="@(showForm ? "display:none;" : "")">
            <form id="select-address-form" asp-action="SelectAddress" method="post">
                @Html.AntiForgeryToken()
                <ul class="list-group">
                    @for (var i = 0; i < Model.Existing.Count; i++)
                    {
                        var userAddress = Model.Existing[i];
                        var isChecked = Model.SelectedAddressId == userAddress.Id;

                        <li class="list-group-item">
                            <div class="row">

                                <div class="col-1 align-content-center">
                                    <input type="radio" class="btn-radio address-radio" name="SelectedAddressId" value="@userAddress.Id" @(isChecked ? "checked" : null)/>
                                </div>

                                <div class="col-11">
                                    <div class="row align-items-center">
                                        <div class="col-6">
                                            <label class="d-flex text-start py-2">
                                                <div class="flex-grow-1">
                                                    <h6>@userAddress.FirstName @userAddress.LastName</h6>
                                                    <h6>@userAddress.Street</h6>
                                                    <h6>@userAddress.PostalCode @userAddress.City</h6>
                                                    <h6>@userAddress.PhoneNumber</h6>
                                                </div>
                                            </label>
                                        </div>

                                        <div class="col-4 text-start">
                                            <h6> Ordrebekreftelse sendes til @userAddress.AspNetUsers.Email</h6>
                                        </div>

                                        <!-- Edit icon/button -->
                                        <div class="col-2 d-flex justify-content-end">
                                            <button class="edit-btn" onclick="editAddress(@userAddress.Id)" type="button" aria-label="Rediger">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24"height="24" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M4 20h4l10.5-10.5-4-4L4 16v4z"/>
                                                    <path d="M14.5 5.5 18 9"/>
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }

                    <li class="list-group-item py-3 px-6">
                        Ønsker du å legge til en ny adresse? <a href="#" id="show-form-link">Legg til ny adresse</a>
                    </li>
                </ul>
            </form>
        </div>
    }
    else
    {
        <form id="select-address-form" asp-action="SelectAddress" method="post">
            <ul class="list-group">
                <li id="no-address-box" class="list-group-item py-4 px-6" style="@(showForm ? "display:none;" : "")">
                    Du har ingen lagrede adresser. <a href="#" id="show-form-link">Legg til ny adresse</a>
                </li>
            </ul>
        </form>
    }

    <!-- Form to add address -->
    <div id="add-address-form-wrapper" style="@(showForm ? "" : "display:none;")">
        <!-- Form for adding address -->
        <form asp-action="AddAddress" asp-controller="Checkout" method="post" id="add-address-form">
            @Html.AntiForgeryToken()
            <ul class="list-group">
                <li class="list-group-item py-4 px-6">
                    <div class="row mb-4">
                        <div class="col">
                            <div class="floating-border-label">
                                <input asp-for="NewAddress.FirstName" type="text" class="form-control" placeholder=""/>
                                <label asp-for="NewAddress.FirstName"></label>
                                <span asp-validation-for="NewAddress.FirstName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col">
                            <div class="floating-border-label">
                                <input asp-for="NewAddress.LastName" type="text" class="form-control" placeholder=""/>
                                <label asp-for="NewAddress.LastName"></label>
                                <span asp-validation-for="NewAddress.LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col">
                            <div class="floating-border-label">
                                <input asp-for="NewAddress.PhoneNumber" type="text" class="form-control" placeholder=""/>
                                <label asp-for="NewAddress.PhoneNumber"></label>
                                <span asp-validation-for="NewAddress.PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col">
                            <div class="floating-border-label">
                                <input asp-for="NewAddress.Street" type="text" class="form-control" placeholder=""/>
                                <label asp-for="NewAddress.Street"></label>
                                <span asp-validation-for="NewAddress.Street" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col">
                            <div class="floating-border-label">
                                <input asp-for="NewAddress.PostalCode" id="postalcode" type="text" class="form-control" placeholder=""/>
                                <label asp-for="NewAddress.PostalCode"></label>
                                <span asp-validation-for="NewAddress.PostalCode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col">
                            <div class="floating-border-label">
                                <input asp-for="NewAddress.City" id="city" type="text" class="form-control" placeholder=""/>
                                <label asp-for="NewAddress.City"></label>
                                <span asp-validation-for="NewAddress.City" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mt-3 d-flex gap-2 justify-content-center">
                            <button class="btn-next" type="submit">Lagre adresse</button>
                            <button class="btn btn-outline-secondary" type="button" id="cancel-add-address">Avbryt</button>
                            <button id="delete-address-btn"
                                    type="button"
                                    class="trash-btn"
                                    style="display: none;">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                     width="24" height="24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"/>
                                    <path d="M19 6l-1 14H6L5 6m3 0V4h8v2"/>
                                    <line x1="10" y1="11" x2="10" y2="17"/>
                                    <line x1="14" y1="11" x2="14" y2="17"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </li>
            </ul>
        </form>

    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />    
    <script src="~/js/utils/postLookup.js" asp-append-version="true"></script>
    <script src="~/js/components/addressFormManager.js" asp-append-version="true"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", () => {
        
            const radios = document.querySelectorAll(".address-radio");
        
            radios.forEach(r => {
                r.addEventListener("change", async () => {
        
                    const addressId = r.value;

                    await fetch(`/Checkout/SetAddress?addressId=${addressId}`, {
                        method: "POST"
                    });
                });
            });
        
        });
    </script>
}