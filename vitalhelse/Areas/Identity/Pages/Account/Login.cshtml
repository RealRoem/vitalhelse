@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="account-container">
    <div class="account-card">
        <h2 class="account-title">Velkommen tilbake</h2>
        <p class="account-subtitle">Logg inn på kontoen din</p>

        <form id="account" method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-group">
                <label asp-for="Input.Email">E-post</label>
                <input asp-for="Input.Email" placeholder="navn@epost.no"/>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password">Passord</label>
                <input asp-for="Input.Password" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-remember">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe">Husk meg?</label>
            </div>

            <button id="login-submit" type="submit" class="btn-submit">Logg inn</button>

            <div class="account-links">
                <a asp-page="./ForgotPassword">Glemt passord?</a>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Opprett ny konto</a>
            </div>
        </form>
    </div>
    
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
