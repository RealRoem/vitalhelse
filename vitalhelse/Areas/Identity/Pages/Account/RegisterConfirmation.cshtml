@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Registrering fullført";
}

<div class="account-container">
    <div class="account-card">
        <h2 class="account-title">Registrering fullført</h2>

        @if (Model.DisplayConfirmAccountLink)
        {
            <p class="account-subtitle">
                Denne applikasjonen har foreløpig ikke konfigurert en ekte e-posttjeneste.  
                Les mer i <a href="https://aka.ms/aspaccountconf" target="_blank">dokumentasjonen her</a>.  
                Normalt ville du mottatt en e-post med en bekreftelseslenke.  
                Klikk i stedet her for å bekrefte kontoen din:
            </p>
            <div class="account-links">
                <a id="confirm-link" href="@Model.EmailConfirmationUrl">Bekreft konto</a>
            </div>
        }
        else
        {
            <p class="account-subtitle">
                Vi har sendt deg en e-post med en lenke for å bekrefte kontoen din.  
                Sjekk innboksen (og søppelpostmappen) din.
            </p>

            <div class="account-links">
                <a asp-page="./Login">Gå til innlogging</a>
            </div>
        }
    </div>
</div>