@page
@model BusinessRegisterModel
@{
    ViewData["Title"] = "Registrer Bedrift";
}

<div class="account-container">
    <div class="account-card">
        <h2 class="account-title">Registrer bedrift</h2>
        <p class="account-subtitle">Fyll inn bedriftsinformasjonen nedenfor</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-group">
                <label asp-for="Input.Email">E-post <span class="text-danger">*</span></label>
                <input asp-for="Input.Email" placeholder="navn@bedrift.no" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.PhoneNumber">Telefon <span class="text-danger">*</span></label>
                <input asp-for="Input.PhoneNumber" placeholder="Telefonnummer" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.OrgName">Organisasjonsnavn <span class="text-danger">*</span></label>
                <input asp-for="Input.OrgName" placeholder="Bedriftens navn" />
                <span asp-validation-for="Input.OrgName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.OrgNr">Organisasjonsnummer <span class="text-danger">*</span></label>
                <input asp-for="Input.OrgNr" placeholder="Organisasjonsnummer (9 siffer)" />
                <span asp-validation-for="Input.OrgNr" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password">Passord <span class="text-danger">*</span></label>
                <input asp-for="Input.Password" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword">Bekreft passord <span class="text-danger">*</span></label>
                <input asp-for="Input.ConfirmPassword" placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn-submit">Registrer bedrift</button>

            <div class="account-links">
                <a asp-area="Identity" asp-page="/Account/Register">Registrer som privatkunde</a>
                <a asp-area="Identity" asp-page="/Account/Login">Allerede registrert? Logg inn</a>
            </div>
        </form>

        @* Ekstern pålogging, f.eks. Google eller Microsoft *@
        <section class="external-login">
            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <p class="small-text">
                        Ingen eksterne påloggingstjenester er konfigurert.
                        <a href="https://go.microsoft.com/fwlink/?LinkID=532715" target="_blank">
                            Les mer her
                        </a>.
                    </p>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <p>Registrer via:</p>
                        <div class="external-buttons">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn-submit"
                                        name="provider" value="@provider.Name"
                                        title="Registrer med @provider.DisplayName">
                                    @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
