@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrer";
}

<div class="account-container">
    <div class="account-card">
        <h2 class="account-title">Opprett konto</h2>
        <p class="account-subtitle">Fyll inn informasjonen nedenfor</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-group">
                <label asp-for="Input.Email">E-post <span class="text-danger">*</span></label>
                <input asp-for="Input.Email" placeholder="navn@eksempel.no" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="Input.Password">Passord <span class="text-danger">*</span></label>
                <input asp-for="Input.Password" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword">Bekreft passord <span class="text-danger">*</span></label>
                <input asp-for="Input.ConfirmPassword" placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn-submit">Registrer</button>

            <div class="account-links">
                <a asp-area="Identity" asp-page="/Account/Login">Allerede registrert? Logg inn her</a>
                <a asp-area="Identity" asp-page="/Account/BusinessRegister">Registrer deg som bedrift</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/utils/postLookup.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
