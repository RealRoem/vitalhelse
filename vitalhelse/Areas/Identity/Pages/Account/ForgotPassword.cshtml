@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Glemt passord";
}

<div class="account-container">
    <div class="account-card">
        <h2 class="account-title">Glemt passord</h2>
        <p class="account-subtitle">
            Skriv inn e-postadressen din for å motta instruksjoner for å tilbakestille passordet.
        </p>

        <form method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-group">
                <label asp-for="Input.Email">E-post</label>
                <input asp-for="Input.Email" placeholder="navn@epost.no" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-submit">Send tilbakestillingslenke</button>

            <div class="account-links">
                <a asp-page="./Login">Tilbake til innlogging</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}