@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Tilbakestill passord";
}

<div class="account-container">
    <div class="account-card">
        <h2 class="account-title">Tilbakestill passord</h2>
        <p class="account-subtitle">
            Skriv inn e-postadressen din og velg et nytt passord.
        </p>

        <form method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />

            <div class="form-group">
                <label asp-for="Input.Email">E-post</label>
                <input asp-for="Input.Email" placeholder="navn@epost.no" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password">Nytt passord</label>
                <input asp-for="Input.Password" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword">Bekreft passord</label>
                <input asp-for="Input.ConfirmPassword" placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-submit">Lagre nytt passord</button>

            <div class="account-links">
                <a asp-page="./Login">Tilbake til innlogging</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}