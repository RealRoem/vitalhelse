@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "E-post sendt";
}

<div class="account-container">
    <div class="account-card">
        <h2 class="account-title">E-post sendt</h2>
        <p class="account-subtitle">
            Vi har sendt deg en e-post med instruksjoner for å tilbakestille passordet ditt.
            Sjekk innboksen (og søppelpostmappen) din.
        </p>

        <div class="account-links">
            <a asp-page="./Login">Tilbake til innlogging</a>
        </div>
    </div>
</div>