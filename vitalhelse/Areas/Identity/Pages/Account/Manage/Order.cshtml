@page
@model OrdersModel
@{
    ViewData["Title"] = "Mine ordre";
    ViewData["ActivePage"] = ManageNavPages.Order;
}

@if (!Model.Orders.Any())
{
    <div class="alert alert-secondary text-center py-4">
        Du har ingen ordre enda.
    </div>
}
else
{
    int index = 0;

    foreach (var order in Model.Orders)
    {
        var collapseId = $"order_{index}";
        index++;

        <div class="card mb-3 shadow-sm border-0">
            
            <div class="card-header bg-light d-flex justify-content-between align-items-center"
                 data-bs-toggle="collapse"
                 data-bs-target="#@collapseId"
                 role="button">

                <div class="fw-semibold">Ordre #@order.OrderId</div>
                <div class="d-flex align-items-center gap-2">
                    <small class="text-muted">@order.OrderDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                    <i class="bi bi-chevron-down"></i>
                </div>
            </div>

          
            <div id="@collapseId" class="collapse">

                <div class="card-body">

                    <!-- PRODUKTER -->
                    <h6 class="text-uppercase text-muted mb-2">Produkter</h6>
                    <ul class="list-group mb-3">
                        @foreach (var item in order.OrderProducts)
                        {
                            // The price the customer paid, not today's price
                            var unit = item.UnitPrice > 0 ? item.UnitPrice : VitalHelse.Services.Pricing.Effective(item.Product);
                            <li class="list-group-item d-flex justify-content-between">
                                <div class="text-start">
                                    <div class="fw-semibold">@item.Product.ProductName x @item.Quantity stk</div>
                                    <div class="small text-muted text-start">@VitalHelse.Services.Pricing.Money(unit) per stk</div>
                                </div>
                                <div class="fw-semibold">@VitalHelse.Services.Pricing.Money(unit * item.Quantity)</div>
                            </li>
                        }
                    </ul>

                    <!-- LEVERING -->
                    <h6 class="text-uppercase text-muted mb-2">Leveringsinformasjon</h6>
                    <ul class="list-group mb-3">
                        <li class="list-group-item">
                            <strong>@order.ShippingFirstName @order.ShippingLastName</strong><br />
                            @order.ShippingStreet <br />
                            @order.ShippingPostalCode @order.ShippingCity <br />
                            <span class="small text-muted">Tlf: @order.ShippingPhoneNumber</span>

                            @if (!string.IsNullOrEmpty(order.TrackingNumber))
                            {
                                <div class="mt-1 small">
                                    Sporingsnummer: <strong>@order.TrackingNumber</strong>
                                </div>
                            }
                        </li>
                    </ul>

                    <!-- FRAKT -->
                    <h6 class="text-uppercase text-muted mb-2">Frakt</h6>
                    <ul class="list-group mb-3">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Metode: <strong>@order.ShippingMethodName</strong></span>
                            <span>Pris: <strong>@VitalHelse.Services.Pricing.Money(order.ShippingPrice)</strong></span>
                        </li>
                    </ul>

                    <!-- TOTALSUM -->
                    @if (!string.IsNullOrEmpty(order.DiscountCodeId))
                    {
                        <div class="d-flex justify-content-between text-success border-top pt-3">
                            <span>Rabattkode:</span>
                            <span>@order.DiscountCodeId</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between border-top pt-3">
                        <span class="fw-semibold">Totalsum:</span>
                        <span class="fw-bold">@VitalHelse.Services.Pricing.Money(order.TotalCost)</span>
                    </div>
                    <div class="d-flex justify-content-between text-muted small">
                        <span>Herav MVA (25 %):</span>
                        <span>@VitalHelse.Services.Pricing.Money(VitalHelse.Services.Pricing.VatPart(order.TotalCost))</span>
                    </div>
                </div>

                <div class="card-footer bg-white text-muted">
                    Status: <strong>@order.Status</strong>
                </div>

            </div>
        </div>
    }
}
