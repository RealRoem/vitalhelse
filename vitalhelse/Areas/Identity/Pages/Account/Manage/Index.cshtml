@page
@model IndexModel
@{
    ViewData["Title"] = "Profil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}


<partial name="_StatusMessage" for="StatusMessage" /> 
<div class="account-container">
    <div class="account-card">
        <form id="form-group" method="post" class="account-form">
            <div class="form-group">
                <label asp-for="Input.Email">E-post <span class="text-danger"></span></label>
                <input asp-for="Input.Email" class="form-control" disabled/>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Username">Brukernavn <span class="text-danger"></span></label>
                <input asp-for="Input.Username" class="form-control" disabled/>
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.FirstName">Fornavn <span class="text-danger"></span></label>
                <input asp-for="Input.FirstName" placeholder="Fornavn" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.LastName">Etternavn <span class="text-danger"></span></label>
                <input asp-for="Input.LastName" placeholder="Etternavn" />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.PhoneNumber">Telefon <span class="text-danger"></span></label>
                <input asp-for="Input.PhoneNumber" placeholder="Telefonnummer" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
          
            <button id="registerSubmit" type="submit" class="btn-submit">Lagre endringer</button>
            
        </form>
        
    </div>

</div>


@section Scripts {
    <script src="~/js/utils/postLookup.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
