@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@functions
{
    public IActionResult OnGet()
    {
        if (User.IsInRole("BusinessCustomer"))
        {
            return Redirect("/Identity/Account/Manage/businessprofile");
        }
        else
        {
            return Redirect("/Identity/Account/Manage");
        }
    }
}
