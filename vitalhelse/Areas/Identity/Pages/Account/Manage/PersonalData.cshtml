@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personopplysninger";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p class="m-2">Kontoen din inneholder personopplysninger som er registrert hos oss. På denne siden kan du laste ned eller slette opplysningene.</p>
        <p>
            <strong> Sletting av disse dataene vil fjerne kontoen din permanent. Da kan den kan ikke gjenopprettes.</strong>
        </p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="btn btn-primary" type="submit">Last ned</button>
        </form>
        <p class="m-4">
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">Slett konto</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
