@page
@model BuisnessProfileModel

@{
    ViewBag.Title = "Min bedrift";
    ViewData["ActivePage"] = ManageNavPages.BusinessProfile;
}


<partial name="_StatusMessage" for="StatusMessage" /> 
<div class="account-container">
    <div class="account-card">
        <form id="form-group" method="post" class="account-form">
            <div class="form-group">
                <label asp-for="Input.Email">E-post <span class="text-danger"></span></label>
                <input asp-for="Input.Email" class="form-control" disabled/>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.PhoneNumber">Telefon <span class="text-danger"></span></label>
                <input asp-for="Input.PhoneNumber" placeholder="Telefonnummer"/>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.OrgName">Organisasjonsnavn<span class="text-danger"></span></label>
                <input asp-for="Input.OrgName" placeholder="Bedriftens navn" />
                <span asp-validation-for="Input.OrgName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.OrgNr">Organisasjonsnummer <span class="text-danger"></span></label>
                <input asp-for="Input.OrgNr" class="form-control" disabled />
                <span asp-validation-for="Input.OrgNr" class="text-danger"></span>
            </div>
            
            <button id="registerSubmit" type="submit" class="btn-submit">Lagre endringer</button>
            
        </form>
    </div>
</div>


@section Scripts {
    <script src="~/js/utils/postLookup.js"></script>
    <partial name="_ValidationScriptsPartial" />
}

