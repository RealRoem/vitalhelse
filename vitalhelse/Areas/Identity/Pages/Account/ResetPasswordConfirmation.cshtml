@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Passord tilbakestilt";
}

<div class="account-container">
    <div class="account-card">
        <h2 class="account-title">Passord tilbakestilt</h2>
        <p class="account-subtitle">
            Passordet ditt er nå endret. Du kan logge inn med det nye passordet.
        </p>

        <div class="account-links">
            <a asp-page="./Login">Gå til innlogging</a>
        </div>
    </div>
</div>