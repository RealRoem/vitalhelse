# Copy to .env to enable the real integrations. Without them the site runs in demo mode.
# Stripe (checkout). Without STRIPE_SECRET_KEY the checkout creates a simulated order.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
DOMAIN=http://localhost:1515

# SendGrid (registration / password reset emails). Without it emails are written to the console.
AUTHMESSAGESENDEROPTIONS__SENDERGRIDKEY=

# SMTP (order receipts sent by the Stripe webhook)
EMAIL__HOST=
EMAIL__USERNAME=
EMAIL__PASSWORD=

# Tripletex product sync: set Tripletex__Enabled=true and provide tokens
Tripletex__Enabled=false
Tripletex__ConsumerToken=
Tripletex__EmployeeToken=
