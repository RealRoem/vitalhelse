@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<div class="dashboard-container">


    <!-- ============================ -->
    <!--   PRODUKTER & KATEGORIER     -->
    <!-- ============================ -->
    <h2 class="dashboard-section-title">Produkter & Kategorier</h2>
    <section class="manage-section">

        <a asp-controller="Admin" asp-action="Products" class="manage-card">
            <div class="icon">📦</div>
            <h3>Produkter</h3>
            <p>Administrer produkter, bilder og prisinformasjon.</p>
        </a>

        <a asp-controller="Admin" asp-action="Categories" class="manage-card">
            <div class="icon">🏷️</div>
            <h3>Kategorier</h3>
            <p>Endre og organisér kategori-strukturen.</p>
        </a>

        <a asp-controller="HomePageManagement" asp-action="Index" class="manage-card">
            <div class="icon">🖼️</div>
            <h3>Bannere</h3>
            <p>Rediger bilder og bannere for forsiden.</p>
        </a>

    </section>



    <!-- ============================ -->
    <!--     PRISER & KAMPANJER       -->
    <!-- ============================ -->
    <h2 class="dashboard-section-title">Rabatter & Kampanjer</h2>
    <section class="manage-section">

        <a asp-controller="DiscountCode" asp-action="Index" class="manage-card">
            <div class="icon">🎟️</div>
            <h3>Rabattkoder</h3>
            <p>Lag og administrer rabattkoder.</p>
        </a>

        <a asp-controller="CategoryDiscount" asp-action="Index" class="manage-card">
            <div class="icon">📉</div>
            <h3>Rabattsatser</h3>
            <p>Sett rabatter per kategori.</p>
        </a>

        <a asp-controller="Campaign" asp-action="Index" class="manage-card">
            <div class="icon">🔥</div>
            <h3>Kampanjer</h3>
            <p>Konfigurer kampanjer for hele utvalget.</p>
        </a>

    </section>



    <!-- ============================ -->
    <!--     ORDRE & LOGISTIKK        -->
    <!-- ============================ -->
    <h2 class="dashboard-section-title">Ordre & Logistikk</h2>
    <section class="manage-section">

        <a asp-controller="OrderManagement" asp-action="Orders" class="manage-card">
            <div class="icon">🧾</div>
            <h3>Ordre</h3>
            <p>Se ordre, status og kundeinformasjon.</p>
        </a>

        <a asp-controller="ShippingManagement" asp-action="Shipping" class="manage-card">
            <div class="icon">🚚</div>
            <h3>Frakt</h3>
            <p>Administrer fraktalternativer og regler.</p>
        </a>

    </section>



    <!-- ============================ -->
    <!--         ADMINISTRASJON       -->
    <!-- ============================ -->
    <h2 class="dashboard-section-title">Administrasjon</h2>
    <section class="manage-section">

        <a asp-controller="UserManagement" asp-action="Index" class="manage-card">
            <div class="icon">🧑‍💼</div>
            <h3>Ansatte</h3>
            <p>Administrer brukere og roller.</p>
        </a>

    </section>

</div>
