@model VitalHelse.Models.ProductFormViewModel
@using VitalHelse.Helpers

@{
bool isEditMode = ViewData["IsEditMode"] != null && (bool)ViewData["IsEditMode"];
ViewData["Title"] = isEditMode ? "Rediger Produkt" : "Legg til Produkt";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="SaveProduct" method="post">
    @Html.AntiForgeryToken()

    @if (isEditMode)
    {
        <input type="hidden" asp-for="Product.ProductId" />
    }

    <div class="form-group mb-3">
        <input type="hidden" asp-for="TempID" id="TempID"/>
        <label>Produkt Bilder</label>
        <button type="button" class="btn btn-secondary" id="uploadButton">Legg til bilder</button>
        <small class="form-text text-muted d-block">Støttede formater: JPG, PNG, WebP, AVIF, GIF</small>
        <div id="previewImages" class="mt-2"></div>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Product.ProductName" class="form-label">Produkt navn</label>
        <input asp-for="Product.ProductName" class="form-control" placeholder="Skriv produkt navn her..."/>
        <span asp-validation-for="Product.ProductName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Product.ProductDescription" class="form-label">Produkt Beskrivelse</label>
        <textarea asp-for="Product.ProductDescription" class="form-control" placeholder="Skriv produkt beskrivelse..."></textarea>
        <span asp-validation-for="Product.ProductDescription" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Product.ProductInstructions" class="form-label">Bruk</label>
        <textarea asp-for="Product.ProductInstructions" class="form-control" rows="3" placeholder="Skriv bruksområdet her..."></textarea>
        <span asp-validation-for="Product.ProductInstructions" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Product.ProductIngredients" class="form-label">Ingredienser</label>
        <textarea asp-for="Product.ProductIngredients" class="form-control" rows="3" placeholder="Skriv ingrediensene her..."></textarea>
        <span asp-validation-for="Product.ProductIngredients" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Product.ProductPriceInVAT" class="form-label">Produkt Pris</label>
        <input asp-for="Product.ProductPriceInVAT" class="form-control"/>
        <span asp-validation-for="Product.ProductPriceInVAT" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label for="categories">Kategorier</label>
        <div class="dropdown-checkbox" id="categoryDropdown">
            <div class="dropdown-selected">Velg Kategorier</div>
            <div class="dropdown-options">
                @foreach (var category in Model.AllCategories)
                {
                    <label class="dropdown-option-item">
                        <span class="category-name">@category.CategoryName</span>
                        <input type="checkbox" name="SelectedCategoryIds" value="@category.CategoryId" @(Model.SelectedCategoryIds != null && Model.SelectedCategoryIds.Contains(category.CategoryId) ? "checked" : "") />
                    </label>
                }
            </div>
        </div>
    </div>
    
    <div class="form-group mb-3">
        <label for="sizes">Størrelser / Størrelse</label>
        <div class="dropdown-checkbox" id="sizeDropdown">
            <div class="dropdown-selected">Velg Størrelser</div>
            <div class="dropdown-options">
                @foreach (var size in Model.AllPhysicalAttributes)
                {
                    <label class="dropdown-option-item">
                        <span class="size-name">@size.Attribute</span>
                        <input type="checkbox" name="SelectedPhysicalAttributeIds" value="@size.PhysicalAttributeId" @(Model.SelectedPhysicalAttributeIds != null && Model.SelectedPhysicalAttributeIds.Contains(size.PhysicalAttributeId) ? "checked" : "") />
                    </label>
                }
            </div>
        </div>
    </div>


    <div class="form-group mb-3">
        <label asp-for="Product.ProductCampaignPrice" class="form-label">Kampanje Pris</label>
        <input asp-for="Product.ProductCampaignPrice" class="form-control"/>
        <span asp-validation-for="Product.ProductCampaignPrice" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Product.StockCount" class="form-label">Lager Beholdning</label>
        <input asp-for="Product.StockCount" class="form-control"/>
        <span asp-validation-for="Product.StockCount" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="tag-input">Etiketter</label>
        <div class="tag-input-container" id="tag-input-container">
            <input type="text" id="tag-input" class="tag-input" placeholder="Skriv og press enter..."/>
        </div>
    </div>

    <div id="hidden-tags-container">
        @foreach (var tag in Model.Tags)
        {
            <input type="hidden" name="Tags" value="@tag"/>
        }
    </div>

    <button type="submit" class="btn btn-primary">Lagre Produkt</button>
    @if (isEditMode)
    {
        <button type="button" class="btn btn-danger ms-2" id="deleteProductBtn">Slett Produkt</button>
    }

</form>

@if (isEditMode)
{
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteConfirmModalLabel">Bekreft sletting</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Er du sikker på at du vil slette dette produktet? Denne handlingen kan ikke angres.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Slett</button>
                </div>
            </div>
        </div>
    </div>
}



@section Scripts 
{
    <partial name="_ValidationScriptsPartial"/>
    
    
    <script>

        window.existingProductImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExistingImagePaths ?? new List<string>()));
        window.productTags = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tags ?? new List<string>()));
        window.allProductTags = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllTags ?? new List<string>()));

    </script>
    
    <script src="~/js/temp/product-form-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/temp/product-form-tags.js" asp-append-version="true"></script>
    <script src="~/js/temp/product-form-images.js" asp-append-version="true"></script>
    
    @if (isEditMode)
    {
        <script src="~/js/temp/product-form-delete.js" asp-append-version="true"></script>
    }
  
}