@model VitalHelse.Models.EditUserRolesViewModel

@{
    ViewData["Title"] = "Rediger Roller";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card editroles-main-card">
                <div class="card-header editroles-header-section">
                    <h4 class="mb-0 editroles-header-title">
                        <i class="fas fa-user-edit me-2"></i>
                        Rediger Roller
                    </h4>
                    <a asp-action="Index" class="edituser-back-button">
                        <i class="fas fa-arrow-left"></i> Tilbake
                    </a>
                </div>
                <div class="card-body editroles-card-body">
                    <!-- User Profile Section -->
                    <div class="editroles-user-profile">
                        <div class="editroles-avatar-circle">
                            <i class="fas fa-user-circle"></i>
                        </div>
                        <h5 class="editroles-user-email">@Model.Email</h5>
                    </div>

                    <form asp-controller="UserManagement" asp-action="UpdateRoles" method="post">
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Email" />

                        <!-- Roles Section -->
                        <div class="editroles-form-section">
                            <label class="editroles-section-label">
                                <i class="fas fa-user-tag me-2"></i>
                                Velg roller:
                            </label>
                            
                            <div class="editroles-roles-container">
                                @for (int i = 0; i < Model.Roles.Count; i++)
                                {
                                    <div class="editroles-role-item">
                                        <input type="hidden" asp-for="Roles[i].RoleName" />
                                        <input class="form-check-input editroles-checkbox" 
                                               type="checkbox" 
                                               asp-for="Roles[i].IsSelected" 
                                               id="role_@i" />
                                        <label class="editroles-role-label" for="role_@i">
                                            <span class="editroles-role-name">@Model.Roles[i].RoleName</span>
                                            <span class="editroles-role-badge">
                                                @switch (Model.Roles[i].RoleName)
                                                {
                                                    case "Admin":
                                                        <small>Full tilgang</small>
                                                        break;
                                                    case "Staff":
                                                        <small>Ansatt</small>
                                                        break;
                                                    case "BusinessCustomer":
                                                        <small>Bedriftskunde</small>
                                                        break;
                                                }
                                            </span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="editroles-action-buttons">
                            <button type="submit" class="editroles-save-button">
                                <i class="fas fa-save me-2"></i>
                                Lagre
                            </button>
                            <a asp-controller="UserManagement" asp-action="Index" class="editroles-cancel-button">
                                <i class="fas fa-times me-2"></i>
                                Avbryt
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

