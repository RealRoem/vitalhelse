@model VitalHelse.Models.AddUserViewModel

@{
    ViewData["Title"] = "Legg til ny bruker";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card adduser-main-card">
                <div class="card-header adduser-header-section">
                    <h4 class="mb-0">
                        <i class="fas fa-user-plus me-2"></i>
                        Legg til ny bruker
                    </h4>
                    <a asp-action="Index" class="adduser-back-button">
                        <i class="fas fa-arrow-left"></i> Tilbake
                    </a>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger adduser-validation-alert"></div>

                    <form asp-action="AddUser" method="post">
                        <div class="adduser-form-section">
                            <h5 class="adduser-section-title">
                                <i class="fas fa-user-circle me-2"></i>
                                Brukerinformasjon
                            </h5>
                            
                            <div class="row">
                                <!-- Email -->
                                <div class="col-md-12 mb-3">
                                    <label asp-for="Email" class="form-label">E-postadresse *</label>
                                    <div class="adduser-input-wrapper">
                                        <i class="fas fa-envelope adduser-input-icon"></i>
                                        <input asp-for="Email" class="form-control adduser-input-field" placeholder="bruker@vitalhelse.no" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small add-user-error"></span>
                                </div>
                            </div>
                        </div>

                        <div class="adduser-form-section">
                            <h5 class="adduser-section-title">
                                <i class="fas fa-lock me-2"></i>
                                Sikkerhetsinnstillinger
                            </h5>
                            
                            <div class="row">
                                <!-- Password -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Password" class="form-label mb-3">Passord *</label>
                                    <div class="adduser-input-wrapper mb-3">
                                        <i class="fas fa-key adduser-input-icon"></i>
                                        <input asp-for="Password" class="form-control adduser-input-field" placeholder="••••••••" />
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small add-user-error"></span>
                                </div>

                                <!-- Confirm Password -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label mb-3">Bekreft passord *</label>
                                    <div class="adduser-input-wrapper mb-3">
                                        <i class="fas fa-check-circle adduser-input-icon"></i>
                                        <input asp-for="ConfirmPassword" class="form-control adduser-input-field" placeholder="••••••••" />
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small add-user-error"></span>
                                </div>
                            </div>
                        </div>

                        <div class="adduser-form-section">
                            <h5 class="adduser-section-title">
                                <i class="fas fa-user-tag me-2"></i>
                                Rolletildeling
                            </h5>
                            
                            <p class="adduser-section-description">
                                Velg hvilken rolle(r) den nye brukeren skal ha. Rollene bestemmer tilgangsnivået i systemet.
                            </p>
                            
                            <div class="adduser-roles-container">
                                @for (int i = 0; i < Model.Roles.Count; i++)
                                {
                                    <div class="adduser-role-checkbox-wrapper">
                                        <input type="hidden" asp-for="Roles[i].RoleName" />
                                        <input class="form-check-input adduser-role-checkbox-input" 
                                               type="checkbox" 
                                               asp-for="Roles[i].IsSelected" 
                                               id="role_@i" />
                                        <label class="form-check-label adduser-role-checkbox-label" for="role_@i">
                                            <span class="adduser-role-name">@Model.Roles[i].RoleName</span>
                                            <span class="adduser-role-description">
                                                @switch (Model.Roles[i].RoleName)
                                                {
                                                    case "Admin":
                                                        <small class="text-muted">Full tilgang</small>
                                                        break;
                                                    case "Staff":
                                                        <small class="text-muted">Ansatt tilgang</small>
                                                        break;
                                                    case "BusinessCustomer":
                                                        <small class="text-muted">Bedriftskunde</small>
                                                        break;
                                                }
                                            </span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="adduser-action-buttons">
                            <button type="submit" class="adduser-submit-button">
                                <i class="fas fa-user-plus me-2"></i>
                                Opprett bruker
                            </button>
                            <a asp-action="Index" class="adduser-cancel-button">
                                <i class="fas fa-times me-2"></i>
                                Avbryt
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Password requirements info -->
            <div class="adduser-info-card">
                <div class="adduser-info-card-header">
                    <i class="fas fa-info-circle me-2"></i>
                    Passordkrav og informasjon
                </div>
                <div class="adduser-info-card-body">
                    <ul class="adduser-info-list">
                        <li><i class="fas fa-check-circle text-success me-2"></i>Minimum 6 tegn</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Brukeren kan endre passordet etter første pålogging</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>E-posten blir automatisk bekreftet</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}