@model List<VitalHelse.Models.UserRoleViewModel>

@{
ViewData["Title"] = "Administrer Brukere";
Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5 pb-3">
        <h2></h2>

        <div class="d-flex gap-3">
            <a asp-action="AddUser" class="employee-add-button">
                <i class="fas fa-user-plus"></i> Legg Til Bruker
            </a>
            <a asp-controller="Admin" asp-action="Dashboard" class="employee-back-button">
                <i class="fas fa-arrow-left"></i> Tilbake
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show index-role-updated" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
                <i class="fas fa-times index-role-updated-x-icon"></i>
            </button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="admin-user-grid">
            @foreach (var user in Model)
            {
                <div class="admin-user-card">
                    <div class="admin-product-actions">
                        <a asp-action="EditRoles" asp-route-id="@user.UserId" class="employee-edit-button">
                            <i class="fas fa-edit"></i> Rediger
                        </a>
                    </div>

                    <div class="text-center mb-3">
                        <i class="fas fa-user-circle fa-5x text-secondary"></i>
                    </div>

                    <h5 class="text-center">@user.Email</h5>

                    <div class="text-center mt-3">
                        @if (user.CurrentRoles.Any())
                        {
                            @foreach (var role in user.CurrentRoles)
                            {
                                <span class="role-badge me-1 mb-1">@role</span>

                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary">Ingen roller</span>
                        }
                    </div>

                    <div class="mt-3 text-center">
                        <small class="text-muted">Bruker ID: @user.UserId.Substring(0, 8)...</small>
                    </div>
                </div>
            }
        </div>

    }
    else
    {
    <p class="text-muted text-center mt-4">Ingen brukere funnet.</p>
    }
</div>

