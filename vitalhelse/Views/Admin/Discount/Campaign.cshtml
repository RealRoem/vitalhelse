@model List<VitalHelse.Models.Discount.Campaign>

@{
    ViewData["Title"] = "Kampanjer";
    Layout = "_AdminLayout";
}

<div class="campaign-container">

    <h2 class="section-title">Opprett kampanje</h2>

    <form method="post" asp-action="Create" asp-controller="Campaign" class="discountcode-form-inline">

        <div class="form-group-inline">

            <div class="form-row">
                <label>Navn</label>
                <input type="text" name="Name" required/>
            </div>

            <div class="form-row">
                <label>Startdato</label>
                <input type="datetime-local" name="Start" required/>
            </div>

            <div class="form-row">
                <label>Sluttdato</label>
                <input type="datetime-local" name="End" required/>
            </div>

        </div>


        <div class="form-row">
            <label>Velg kategorier</label>

            <div class="category-multiselect">
                @foreach (var category in ViewBag.AllCategories)
                {
                    <label class="category-chip">
                        <input type="checkbox" name="CategoryIds" value="@category.CategoryId" />
                        <span>@category.CategoryName</span>
                    </label>
                }
            </div>

        </div>

        <button type="submit" class="btn-create">Opprett kampanje</button>
    </form>

    <div class="divider"></div>

    <h3 class="section-title">Alle kampanjer</h3>

    <table class="campaign-table">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Kategorier</th>
                <th>Periode</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
        @foreach (var c in Model)
        {
            bool expired = c.End < DateTime.Now;
            var toggleText = c.IsActive ? "Deaktiver" : "Aktiver";

            <tr>
                <!-- Kampanjenavn -->
                <td>@c.Name</td>

                <!-- Kategorier -->
                <td>
                    @if (c.CategoryIds.Count == 0)
                    {
                        <span>Ingen kategorier</span>
                    }
                    else
                    {
                        <span>@string.Join(", ", ViewBag.CategoryLookup[c.CampaignId])</span>
                    }
                </td>

                <!-- Periode -->
                <td>@c.Start.ToString("yyyy-MM-dd HH:mm") – @c.End.ToString("yyyy-MM-dd HH:mm")</td>

                <!-- Status -->
                <td>
                    @if (expired)
                    {
                        <span class="status-expired">Utløpt</span>
                    }
                    else if (c.IsActive)
                    {
                        <span class="status-active">Aktiv</span>
                    }
                    else
                    {
                        <span class="status-inactive">Inaktiv</span>
                    }
                </td>

                <!-- Handlinger -->
                <td class="action-buttons">

                    @if (!expired)
                    {
                        <form method="post" asp-action="Toggle" asp-controller="Campaign">
                            <input type="hidden" name="id" value="@c.CampaignId" />
                            <button class="btn-toggle">@toggleText</button>
                        </form>
                    }

                    <form method="post" asp-action="Delete" asp-controller="Campaign">
                        <input type="hidden" name="id" value="@c.CampaignId" />
                        <button class="btn-delete-icon">
                            <img src="~/images/icons/trash.svg" alt="Slett" />
                        </button>
                    </form>

                </td>
            </tr>
        }
        </tbody>

    </table>

</div>
