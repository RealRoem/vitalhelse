@model List<VitalHelse.Models.Discount.DiscountCode>

@{
    ViewData["Title"] = "Rabattkoder";
    Layout = "_AdminLayout";
}

<div class="discountcodes-container">

    <h2 class="section-title">Opprett rabattkode</h2>
    AspNetUserRoles
    <form method="post" asp-action="Create" asp-controller="DiscountCode" class="discountcode-form-inline">

        <div class="form-group-inline">

            <div class="form-row">
                <label>Kode</label>
                <input type="text" name="Code" required />
            </div>

            <div class="form-row">
                <label>Rabatt (%)</label>
                <input type="number" name="DiscountPercent" min="1" max="100" required />
            </div>

            <div class="form-row">
                <label>Utløper (valgfritt)</label>
                <input type="datetime-local" name="ExpiresAt" />
            </div>

        </div>

        <button type="submit" class="btn-create">Opprett rabattkode</button>
    </form>

    <div class="divider"></div>

    <h3 class="section-title">Alle rabattkoder</h3>

    <table class="discountcode-table">
    <thead>
        <tr>
            <th>Kode</th>
            <th>Rabatt</th>
            <th>Brukt</th>
            <th>Opprettet</th>
            <th>Utløper</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var code in Model)
        {
            var toggleText = code.IsActive ? "Deaktiver" : "Aktiver";
            bool expired = code.ExpiresAt.HasValue && code.ExpiresAt.Value < DateTime.Now;

            <tr>
                <!-- Kode -->
                <td>@(code.Code)</td>

                <!-- Rabatt (%) -->
                <td>@(code.DiscountPercent) %</td>

                <!-- Brukt antall ganger -->
                <td>@(code.TimesUsed)</td>

                <!-- Opprettet dato -->
                <td>@(code.CreatedAt.ToString("yyyy-MM-dd HH:mm"))</td>

                <!-- Utløper -->
                <td>
                    @(code.ExpiresAt.HasValue
                        ? code.ExpiresAt.Value.ToString("yyyy-MM-dd HH:mm")
                        : "Aldri")
                </td>

                <!-- Status -->
                <td>
                    @if (expired)
                    {
                        <span class="status-expired">Utløpt</span>
                    }
                    else if (code.IsActive)
                    {
                        <span class="status-active">Aktiv</span>
                    }
                    else
                    {
                        <span class="status-inactive">Inaktiv</span>
                    }
                </td>

                <!-- Handlinger -->
                <td class="action-buttons">

                    @if (!expired)
                    {
                        <form method="post" asp-action="Toggle" asp-controller="DiscountCode">
                            <input type="hidden" name="id" value="@(code.DiscountCodeId)"/>
                            <button type="submit" class="btn-toggle">@toggleText</button>
                        </form>
                    }

                    <form method="post" asp-action="Delete" asp-controller="DiscountCode">
                        <input type="hidden" name="id" value="@(code.DiscountCodeId)"/>
                        <button type="submit" class="btn-delete-icon">
                            <img src="~/images/icons/trash.svg" alt="Slett"/>
                        </button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>


</div>
