@model List<StockViewModel>

@{
    ViewBag.Title = "Lager Beholdning";
    Layout = "_AdminLayout";
}

<div class="stock-container">
    <!-- Filter Sidebar -->
    <aside class="filters-sidebar">
        <h4>Filtrer</h4>
        
        <!-- Show All Button -->
        <button type="button" id="showAllBtn" class="btn-show-all">Vis Alle Produkter</button>
        <!-- Export Button -->
        <button type="button" id="exportBtn" class="btn-export">
            <i class="fas fa-file-excel"></i> Eksporter til Excel
        </button>
        <!-- Stock Status Filter -->
        <div class="filter-group">
            <label>Lager Status</label>
            <div class="filter-group toggles">
                <label class = "status-label">
                    <input type="checkbox" class="status-filter" value="ok" checked>
                    <span>OK</span>
                </label>
                <label>
                    <input type="checkbox" class="status-filter" value="low" checked>
                    <span>Lav</span>
                </label>
                <label>
                    <input type="checkbox" class="status-filter" value="out" checked>
                    <span>Utsolgt</span>
                </label>
            </div>
        </div>

        <!-- Category Filter -->
        <div class="filter-group">
            <label>Kategorier</label>
            <div class="category-dropdowns">
                @foreach (var parent in ((IEnumerable<Category>)ViewData["Categories"]).Where(c => c.ParentCategoryId == null))
                {
                    <div class="category-parent">
                        <div class="parent-header">
                            <input type="checkbox"
                                   class="parent-category"
                                   value="@parent.CategoryName"
                                   checked />
                            <span class="parent-name">@parent.CategoryName</span>
                            <span class="toggle-icon">&#9660;</span>
                        </div>

                        <div class="category-children">
                            @foreach (var child in ((IEnumerable<Category>)ViewData["Categories"]).Where(c => c.ParentCategoryId == parent.CategoryId))
                            {
                                <label class="child-label">
                                    <input type="checkbox"
                                           class="child-category"
                                           value="@child.CategoryName"
                                           checked />
                                    @child.CategoryName
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="stock-main">
        <div class="stock-header"></div>
        <h1>Lager Beholdning </h1>

        <table id="stockTable">
            <thead>
            <tr>
                <th>Bilde</th>
                <th>Produkt Navn</th>
                <th>Kategorier</th>
                <th>Pris</th>
                <th>Beholdning</th>
                <th>Status</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var stockCount = item.StockCount ?? 0;
                var statusValue = stockCount <= 0 ? "out" : (stockCount < 10 ? "low" : "ok");
                var rowClass = "";
                var statusText = "";
                var statusClass = "";

                if (stockCount <= 0)
                {
                    rowClass = "out-of-stock-row";
                    statusText = "Utsolgt";
                    statusClass = "status-out";
                }
                else if (stockCount < 10)
                {
                    rowClass = "low-stock-row";
                    statusText = "Lav";
                    statusClass = "status-low";
                }
                else
                {
                    statusText = "OK";
                    statusClass = "status-ok";
                }

                <tr class="@rowClass product-row"
                    data-status="@statusValue"
                    data-categories="@string.Join(",", item.CategoryNames)">
                    <td>
                        @if (!string.IsNullOrEmpty(item.FirstImagePath))
                        {
                            <img src="@item.FirstImagePath" alt="@item.ProductName" class="product-thumbnail"/>
                        }
                        else
                        {
                            <div class="no-image">Ingen bilde</div>
                        }
                    </td>
                    <td>@item.ProductName</td>
                    <td>
                        @if (item.CategoryNames.Any())
                        {
                            @string.Join(", ", item.CategoryNames)
                        }
                        else
                        {
                            <span class="no-category">Ingen kategori</span>
                        }
                    </td>
                    <td>@item.ProductPriceInVAT kr</td>
                    <td><strong>@stockCount</strong></td>
                    <td>
                        <span class="status-badge @statusClass">@statusText</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </main>
</div>

<script src="~/js/components/AdminStockCountFilterBar.js"></script>


<script>//export button for the excel file
const exportBtn = document.getElementById('exportBtn');

exportBtn.addEventListener('click', function() {
    //show loading state
    exportBtn.disabled = true;
    exportBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Eksporterer...';
    
    //trigger download
    window.location.href = '/Stock/ExportStockToExcel';
    
    //reseys button after 2 seconds
    setTimeout(() => {
        exportBtn.disabled = false;
        exportBtn.innerHTML = '<i class="fas fa-file-excel"></i> Eksporter til Excel';
    }, 2000);
});</script>