@using VitalHelse.Helpers
@model IEnumerable<VitalHelse.Models.Product>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
var authorized = (await AuthorizationService.AuthorizeAsync(User, "Privileged")).Succeeded;
bool isAdminView = ViewData["IsAdminView"] as bool? ?? false;
}

@if (Model != null && Model.Any())
{
@Html.AntiForgeryToken()

<div class="product-grid">
    @foreach (var product in Model)
    {
    var isHidden = product.LabelDescription?.ToLower().Contains("hidden") ?? false;

    decimal? original = product.ProductPriceInVAT;
    decimal? campaign = product.ProductCampaignPrice;
    decimal? businessPrice = product.ProductPriceExVAT;
    decimal businessCampaign = 0;
    int discountPercent = 0;

    if (User.IsInRole("BusinessCustomer") && campaign.HasValue && businessPrice.HasValue && original.HasValue && original.Value > 0)
    {
    decimal vatFactor = businessPrice.Value / original.Value;
    businessCampaign = campaign.Value * vatFactor;
    discountPercent = (int)Math.Round((1 - (campaign.Value / original.Value)) * 100);
    }
    else if (campaign.HasValue && original.HasValue && original.Value > 0)
    {
    discountPercent = (int)Math.Round((1 - (campaign.Value / original.Value)) * 100);
    }

    <div class="product-card @(isHidden ? "hidden-product" : "")">

        <!-- Favorittknapp -->
        <button type="button"
                class="heart-btn @(product.IsFavorite ? "active" : "")"
                data-id="@product.ProductId"
                title="Legg til eller fjern favoritt">
            <i class="@(product.IsFavorite ? "fa-solid" : "fa-regular") fa-heart"></i>
        </button>

        <!-- Rabattsirkel -->
        @if (campaign.HasValue && discountPercent > 0)
        {
        <div class="discount-circle">-@discountPercent%</div>
        }

        <!-- Klikkbart bilde -->
        <a href="@SlugHelper.BuildProductPath(product)" class="product-img-wrapper">
            <img src="@Url.Content(product.ProductPictures.FirstOrDefault()?.PicturePath ?? "~/images/products/default.png")"
                 alt="@product.ProductName"
                 class="product-img"
                 loading="lazy" />
        </a>

        <!-- Navn -->
        <h5 class="product-name">@product.ProductName</h5>

        <!-- Beskrivelse -->
        <p class="product-desc">@product.ProductDescription</p>

        <!-- Pris -->
        <div class="price">
            @if ((User.IsInRole("BusinessCustomer") || authorized) && businessCampaign != 0 && businessPrice.HasValue)
            {
            <span class="price-new price-incvat">@campaign!.Value.ToString("0.00") kr</span>
            <span class="price-old price-incvat">@original!.Value.ToString("0.00") kr</span>
            <span class="price-new price-exvat">@businessCampaign.ToString("0.00") kr</span>
            <span class="price-old price-exvat">@businessPrice.Value.ToString("0.00") kr</span>
            }
            else if ((User.IsInRole("BusinessCustomer") || authorized) && businessPrice.HasValue && original.HasValue)
            {
            <span class="price-regular price-exvat">@businessPrice.Value.ToString("0.00") kr</span>
            <span class="price-regular price-incvat">@original.Value.ToString("0.00") kr</span>
            }
            else if (campaign.HasValue && original.HasValue)
            {
            <span class="price-new">@campaign.Value.ToString("0.00") kr</span>
            <span class="price-old">@original.Value.ToString("0.00") kr</span>
            }
            else if (original.HasValue)
            {
            <span class="price-regular">@original.Value.ToString("0.00") kr</span>
            }
        </div>

        <!-- Kjøp-linje -->
        <div class="product-buy-row">
            <div class="quantity-controls">
                <button type="button" class="qty-btn" onclick="ChangeQty(@product.ProductId, -1)">−</button>
                <input id="quantity-@product.ProductId" class="qty-input" value="1" />
                <button type="button" class="qty-btn" onclick="ChangeQty(@product.ProductId, 1)">+</button>
            </div>

            <button type="button" class="btn-submit buy-btn" onclick="AddToCart(@product.ProductId)">
                Kjøp
            </button>
        </div>

    </div>
    }
</div>

<button id="load-more" class="btn-submit" style="margin: 20px auto; display: block;">
    Vis mer
</button>
}
else
{
<p class="text-muted text-center mt-4">Ingen produkter funnet.</p>
}

<!-- FAVORITTER (hjerte) -->
<script>
    (function () {
        const isAuthenticated = @(User.Identity.IsAuthenticated.ToString().ToLower());

        document.addEventListener('click', async (e) => {
            const btn = e.target.closest('.heart-btn');
            if (!btn) return;

            // Ikke trigge annen klikklggik
            e.stopPropagation();

            if (!isAuthenticated) {
                alert("Du må være logget inn for å legge til favoritter ❤️");
                return;
            }

            const id = btn.dataset.id;
            const res = await fetch('/Favorites/ToggleFavorite', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${encodeURIComponent(id)}`
            });

            if (!res.ok) return;

            let isFav = null;
            try {
                const data = await res.json();
                isFav = !!data.isFavorite;
            } catch {
                isFav = !btn.classList.contains('active');
            }

            btn.classList.toggle('active', isFav);
            const icon = btn.querySelector('i');
            icon.classList.toggle('fa-regular', !isFav);
            icon.classList.toggle('fa-solid', isFav);

            // Fjern kort hvis vi står på /favoritter og den fjernes
            if (window.location.pathname.startsWith('/favoritter') && !isFav) {
                const card = btn.closest('.product-card');
                if (card) {
                    card.style.transition = 'opacity .3s ease, transform .25s ease';
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.96)';
                    setTimeout(() => card.remove(), 300);
                }
            }
        });
    })();
</script>

<!-- ADD TO CART + QTY -->
<script>
    async function AddToCart(productId) {
        const isAuthenticated = @(User.Identity.IsAuthenticated.ToString().ToLower());

        const quantityElement = document.getElementById(`quantity-${productId}`);
        const quantity = quantityElement ? parseInt(quantityElement.value, 10) || 1 : 1;

        const tokenField = document.querySelector('input[name="__RequestVerificationToken"]');
        if (!tokenField) {
            console.error("Fant ikke antiforgery-token");
            return;
        }

        const formData = new FormData();
        formData.append("id", productId);
        formData.append("quantity", quantity);

        const response = await fetch("/ShoppingCart/AddToCart", {
            method: 'POST',
            headers: {
                'RequestVerificationToken': tokenField.value
            },
            body: formData
        });

        if (!response.ok) {
            const msg = await response.text();
            const errorBox = document.getElementById("error-box");
            if (errorBox) {
                errorBox.innerText = msg;
                setTimeout(() => errorBox.innerText = "", 3000);
            }
        } else {
            if (!isAuthenticated) {
                window.location.href = "/identity/account/login";
                return;
            }
            window.location.reload();
        }
    }

    function ChangeQty(productId, delta) {
        const input = document.getElementById(`quantity-${productId}`);
        if (!input) return;

        let value = parseInt(input.value) || 1;
        value += delta;
        if (value < 1) value = 1;
        input.value = value;
    }
</script>

<!-- VIS MER + FADE-IN -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const MAX_VISIBLE = 12;
        const cards = Array.from(document.querySelectorAll(".product-card"));
        const loadMoreBtn = document.getElementById("load-more");

        let visibleCount = MAX_VISIBLE;

        cards.forEach((card, index) => {
            if (index >= visibleCount) {
                card.style.display = "none";
            }
        });

        if (loadMoreBtn) {
            loadMoreBtn.addEventListener("click", function () {
                const nextCount = visibleCount + MAX_VISIBLE;

                cards.forEach((card, index) => {
                    if (index < nextCount) {
                        card.style.display = "";
                    }
                });

                visibleCount = nextCount;

                if (visibleCount >= cards.length) {
                    loadMoreBtn.style.display = "none";
                }
            });

            if (cards.length <= MAX_VISIBLE) {
                loadMoreBtn.style.display = "none";
            }
        }

        // Fade-in animasjon
        cards.forEach((card, index) => {
            setTimeout(() => {
                card.classList.add("fade-in");
            }, index * 40);
        });

        // Hindrer at qty/kjøp trigget evt. card-click-logikk andre steder
        document.querySelectorAll(".qty-btn, .qty-input, .buy-btn").forEach(el => {
            el.addEventListener("click", (ev) => {
                ev.stopPropagation();
            });
        });
    });
</script>
