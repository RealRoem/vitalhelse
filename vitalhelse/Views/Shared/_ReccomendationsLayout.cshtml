@using VitalHelse.Services
@model IEnumerable<VitalHelse.Models.ReccomendationsViewModel>

<div class="recommendations-container">
    @if (Model != null && Model.Any())
    {
        <div class="recommendations-section">
            <div class="recommendations-header">
                <h2 class="recommendations-title">Du vil kanskje også like</h2>
                <div class="recommendations-controls">
                    <button class="rec-arrow rec-arrow-left" id="scrollLeft" aria-label="Scroll venstre">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button class="rec-arrow rec-arrow-right" id="scrollRight" aria-label="Scroll høyre">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>
            
            <div class="recommendations-viewport">
                <div class="recommendations-grid" id="recommendationsGrid">
                    @foreach (var product in Model)
                    {
                        var price = new PriceInfo(product.ProductPriceInVAT, product.ProductCampaignPrice);
                        
                        <div class="recommendation-card">
                            @if (price.OnSale && price.Percent > 0)
                            {
                                <div class="discount-badge">-@price.Percent%</div>
                            }
                            
                            <div class="product-image">
                                <a href="@product.ProductUrl" class="product-img-wrapper">
                                    @if (!string.IsNullOrEmpty(product.FirstImagePath))
                                    {
                                        <img src="@Url.Content(product.FirstImagePath)" alt="@product.ProductName" class="product-img" />
                                    }
                                    else
                                    {
                                        <div class="no-image-placeholder">
                                            <i class="fa-solid fa-image"></i>
                                            <span>Ingen bilde</span>
                                        </div>
                                    }
                                </a>
                            </div>
                            
                            <div class="product-info">
                                <a href="@product.ProductUrl" class="product-name-link">
                                    <h3 class="product-name">@product.ProductName</h3>
                                </a>
                                
                                @if (product.CategoryNames.Any())
                                {
                                    <div class="product-categories">
                                        @foreach (var category in product.CategoryNames)
                                        {
                                            <span class="category-badge">@category</span>
                                        }
                                    </div>
                                }
                                
                                <div class="product-price">
                                    <partial name="_Price" model="price" />
                                </div>
                                
                                @if (product.StockCount.HasValue)
                                {
                                    <div class="stock-status">
                                        @if (product.StockCount <= 0)
                                        {
                                            <span class="stock-out">Utsolgt</span>
                                        }
                                        else if (product.StockCount < 10)
                                        {
                                            <span class="stock-low">Få på lager</span>
                                        }
                                        else
                                        {
                                            <span class="stock-ok">På lager</span>
                                        }
                                    </div>
                                }
                                
                                <div class="product-actions">
                                    <a href="@product.ProductUrl" class="btn btn-primary rec-btn">Se detaljer</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>