@using VitalHelse.Models.Enums
@{
    Layout = "_Layout";
    
    // Get the current step from viewbag
    var step = ViewBag.Step is CheckoutStep s ? s : CheckoutStep.Cart;

    string btnText;
    string? nextAction;
    
    // Switch case to determine button text and action depending on the checkout step
    switch (step)
    {
        case CheckoutStep.Cart:
            btnText = "Gå videre til leveringsinfo";
            nextAction = "Address";
            break;
        case CheckoutStep.Address:
            btnText = "Gå videre til leveringmetode";
            nextAction = "SelectAddress";
            break;
        case CheckoutStep.Shipping:
            btnText = "Gå videre til betaling";
            nextAction = "ReviewOrder";
            //nextAction = "/checkout.html";
            break;
        case CheckoutStep.ReviewOrder:
            btnText = "Fullfør bestilling";
            nextAction = "Complete";
            break;
        default:
            btnText = "";
            nextAction = null;
            break;
    }
    // Booleans that determine what steps user can click on
    bool allowCart = true;
    bool allowAddress = step >= CheckoutStep.Address;
    bool allowShipping = step >= CheckoutStep.Shipping;
    bool allowPayment = step >= CheckoutStep.ReviewOrder;
}

<!-- Checkout steps/Mini navbar -->
<ul class="nav checkout-steps border-bottom pb-1">
    
    <!-- STEP 1: CART -->
    <li class="nav-item">
        <a class="nav-link @(step == CheckoutStep.Cart ? "active" : "")"
           href="@(allowCart ? Url.Action("Index", "Checkout", new { }) : "javascript:void(0)")"
           style="@(allowCart ? "" : "pointer-events:none; opacity:0.4;")">Kasse</a>
    </li>
    
    <!-- STEP 2: ADDRESS -->
    <li class="nav-item">
        <a class="nav-link @(step == CheckoutStep.Address ? "active" : "")"
           href="@(allowAddress ? Url.Action("Address", "Checkout", new { }) : "javascript:void(0)")"
           style="@(allowAddress ? "" : "pointer-events:none; opacity:0.4;")">Personalia</a>
    </li>
    
    <!-- STEP 3: SHIPPINGMETHOD -->
    <li class="nav-item">
        <a class="nav-link @(step == CheckoutStep.Shipping ? "active" : "")"
           href="@(allowShipping ? Url.Action("Shipping", "Checkout", new { }) : "javascript:void(0)")"
           style="@(allowShipping ? "" : "pointer-events:none; opacity:0.4;")">Levering</a>
    </li>
    
    <!-- STEP 4: REVIEW ORDER -->
    <li class="nav-item">
        <a class="nav-link @(step == CheckoutStep.ReviewOrder ? "active" : "")"
           href="@(allowPayment ? Url.Action("ReviewOrder", "Checkout", new { }) : "javascript:void(0)")"
           style="@(allowPayment ? "" : "pointer-events:none; opacity:0.4;")">Betaling</a>
    </li>
</ul>

<div class="container mt-3">
    <div class="row g-3">
        <div class="col-md-8">
            @RenderBody()
            
            <!-- Display error -->
            @if (TempData["Error"] != null)
            {
                <div id="error-box" class="alert alert-danger text-center mt-3">
                    @TempData["Error"]
                </div>
            }

            <script>
                document.addEventListener("DOMContentLoaded", () => {
                    const box = document.getElementById("error-box");
                    if (box) {
                        // Remove error after 3 seconds
                        setTimeout(() => {
                            box.style.opacity = "0";
                            box.style.transition = "opacity 0.5s ease";
                            setTimeout(() => box.remove(), 500);
                        }, 3000);
                    }
                });
            </script>
        </div>

        <!-- Summary -->
        <div class="summary col-md-4 text-white">
            <div class="list-group">
                <div class="list-group-item">
                    <h4 class="d-flex justify-content-between fw-semibold mt-1">Sammendrag</h4>
                    <div class="d-flex justify-content-between"><h6>Produkter:</h6><h6 id="sum-products">–</h6></div>
                    <div class="d-flex justify-content-between text-muted"><h6>Produkter før rabatt:</h6><h6 id="sum-before">–</h6></div>
                    <div class="d-flex justify-content-between text-success"><h6>Rabatt på produkter</h6><h6 id="sum-discount">–</h6></div>
                    <div class="d-flex justify-content-between"><h6>Rabattkode</h6><h6 id="sum-code-discount">0%</h6></div>
                    <div class="d-flex justify-content-between"><h6>Frakt</h6><h6 id="sum-shipping">–</h6></div>
                    
                    <!-- Discountcode -->
                    <div class="mt-3">
                        <label for="discount-code" class="fw-semibold">Rabattkode</label>
                        <div class="d-flex gap-2">
                            <input type="text" id="discount-code" class="form-control" placeholder="Skriv inn rabattkode"/>
                            <button type="button" id="apply-discount" class="btn-next w-25">Bruk</button>
                        </div>
                        <p id="discount-message" class="mt-1" style="font-size:14px;"></p>
                    </div>

                    <hr/>
                    <div class="d-flex justify-content-between fw-semibold"><span>Totalsum</span><span id="sum-total">–</span></div>


                    <div class="d-grid mt-3">
                        @if (!string.IsNullOrEmpty(btnText) && !string.IsNullOrEmpty(nextAction))
                        {
                            @if (step == CheckoutStep.Cart)
                            {
                                <a class="btn-next w-100 mb-2" href="@Url.Action("Address", "Checkout")">@btnText</a>
                            }
                            else if (step == CheckoutStep.Address)
                            {
                                <button type="submit" form="select-address-form" class="btn-next w-100 mb-2">@btnText</button>
                            }
                            else if (step == CheckoutStep.Shipping)
                            {
                                <form method="get" asp-controller="Checkout" asp-action="ReviewOrder">
                                    <button type="submit" class="btn-next w-100 mb-2">@btnText</button>
                                </form>
                            }
                            else if (step == CheckoutStep.ReviewOrder)
                            {
                                <a href="/checkout.html" class="btn-next w-100 mb-2">@btnText</a>
                            }
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/components/shoppingCart.js" asp-append-version="true"></script>
<script src="~/js/admin/discount.js" asp-append-version="true"></script>

<script>
// Fuction to run the Summary function on load
document.addEventListener('DOMContentLoaded', function () {
    if (typeof Summary === 'function') {
        Summary();
    }
});
</script>

@await RenderSectionAsync("Scripts", required: false)