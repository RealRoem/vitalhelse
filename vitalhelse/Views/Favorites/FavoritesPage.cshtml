@model VitalHelse.Models.FavoritesViewModel

@{
    ViewData["Title"] = "Mine favoritter";
    Layout = "_Layout";
}

<section class="category-page">
    <h1 class="category-title">Mine Favoritter </h1>

    <!-- Toppknapper -->
    <div class="favorites-actions mb-5 d-flex justify-content-center gap-3 flex-wrap">

        <button type="button" class="fav-btn cart btn-submit" id="AddAllToCart">
            🛒 Legg alle i handlevogn
        </button>
    </div>

    <!-- 🔹 Produkter -->
    @if (Model.Products == null || !Model.Products.Any())
    {
        <p class="text-muted">Du har ingen favoritter enda.</p>
    }
    else
    {
        @await Html.PartialAsync("_ProductGrid",
            Model.Products,
            new ViewDataDictionary(ViewData) {
                { "IsAuthenticated", User.Identity?.IsAuthenticated ?? false }
            })
    }
</section>

@section Scripts{
    <script src="~/js/components/addFavorites.js?v=1"></script>

