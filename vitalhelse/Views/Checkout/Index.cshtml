@using VitalHelse.Models.Enums
@model List<CartProduct>

@{
    ViewBag.Title = "Kasse";
    Layout = "_CheckoutLayout";
}

<form id="cart-form">
    @Html.AntiForgeryToken()
</form>

@if (Model == null || !Model.Any())
{
    <ul class="list-group">
        <li class="list-group-item py-4 px-6">
            Handlekurven er tom
        </li>
    </ul>
}
else
{
    <ul class="list-group">
        @foreach (var item in Model)
        {
            <li id="row-@item.ProductId" class="list-group-item py-4 px-6">
                <div  class="row align-items-center gy-3">

                    <!-- Product image -->
                    <div class="col-3 col-sm-2">
                        <img class="w-75" src="@(item.Product.ProductPictures.FirstOrDefault()?.PicturePath ?? "/images/products/default.png")"
                             alt="@item.Product.ProductName"/>
                    </div>

                    <!-- Product name and stock -->
                    <div class="col">
                        <h6 class="mb-2">@item.Product.ProductName</h6>
                        <!--<div>På lager: @item.Product.StockCount</div> -->
                    </div>

                    <!-- Quantity -->
                    <div class="col-auto">
                        <div class="input-group change-quantity">
                            <button onclick="DecreaseQuantity(@item.ProductId, @((item.Product.ProductCampaignPrice ?? item.Product.ProductPriceInVAT).ToString().Replace(',', '.')), @(item.Product.ProductPriceInVAT.ToString().Replace(',', '.')))" class="btn btn-outline-secondary" type="button">&minus;</button>
                            <input id="quantity-@item.ProductId" class="form-control text-center" style="max-width:60px" value="@item.Quantity" onchange="UpdateQuantity(@item.ProductId, @((item.Product.ProductCampaignPrice ?? item.Product.ProductPriceInVAT).ToString().Replace(',', '.')), @(item.Product.ProductPriceInVAT.ToString().Replace(',', '.')))">
                            <button onclick="AddQuantity(@item.ProductId, @((item.Product.ProductCampaignPrice ?? item.Product.ProductPriceInVAT).ToString().Replace(',', '.')), @(item.Product.ProductPriceInVAT.ToString().Replace(',', '.')))" class="btn btn-outline-secondary" type="button">+</button>
                        </div>
                    </div> 

                    <!-- Price -->
                    <div class="col-auto col-sm-3 col-lg-2 text-end d-flex flex-column align-items-center">
                        @if (item.Product.ProductCampaignPrice != null)
                        {
                            var beforeTotal = item.Product.ProductPriceInVAT * item.Quantity;
                            var afterTotal = item.Product.ProductCampaignPrice.Value * item.Quantity;

                            <!-- Total rice without campaign price -->
                            <div id="before-@item.ProductId" class="text-muted text-decoration-line-through mt-0">
                                @beforeTotal.ToString("N2") kr <!-- Force razor to use 2 decimals, 299,00 -->
                            </div>

                            <!-- Total price with campaign price -->
                            <div id="total-@item.ProductId" class="fw-semibold">
                                @afterTotal.ToString("N2") kr
                            </div>
                        }
                        else
                        {
                            <!-- Total regular price -->
                            <div id="total-@item.ProductId" class="fw-semibold">
                                @((item.Product.ProductPriceInVAT * item.Quantity).ToString("N2")) kr
                            </div>
                        }
                        
                    </div>

                    <!-- Trash bin icon/Remove button -->
                    <div onclick="removItemShoppingCart(@item.ProductId)" class="col-auto text-end">
                        <button class="trash-btn" type="button" aria-label="Fjern">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                 width="24" height="24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6" />
                                <path d="M19 6l-1 14H6L5 6m3 0V4h8v2" />
                                <line x1="10" y1="11" x2="10" y2="17" />
                                <line x1="14" y1="11" x2="14" y2="17" />
                            </svg>
                        </button>
                    </div>
                </div>
            </li>
        }
    </ul>
}