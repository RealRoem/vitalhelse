@model ReviewOrderViewModel
@using VitalHelse.Models.Enums
@using VitalHelse.Services

@{
    ViewBag.Title = "Betaling";
    Layout = "_CheckoutLayout";
}

<h2 class="text-start mb-4 fw-medium">Se gjennom bestillingen</h2>

<!-- PRODUKTER -->
<section class="mb-4">
    <h4 class="text-start fw-semibold">Produkter</h4>
    <ul class="list-group">

        @foreach (var item in Model.CartProducts)
        {
            <li class="list-group-item py-3 px-4">
                <div class="row align-items-center gy-3">

                    <div class="col-3 col-sm-2">
                        <img class="w-75" src="@(item.Product.ProductPictures.FirstOrDefault()?.PicturePath ?? "/images/products/default.png")"
                             alt="@item.Product.ProductName"/>
                    </div>

                    <div class="col">
                        <h6 class="mb-2">@item.Product.ProductName</h6>
                        <div>Antall: @item.Quantity</div>
                    </div>

                    <div class="col">
                        <partial name="_LinePrice" model="(item.Product, item.Quantity)" />
                    </div>
                </div>
            </li>
        }
    </ul>
</section>

<section class="mb-4">
    <h4 class="text-start fw-semibold">Leveringsadresse</h4>
    <ul class="list-group">
        <li class="list-group-item">
            <div class="row">
                <div class="col">
                    <div class="row align-items-center">

                        <div class="col-6">
                            <label class="d-flex text-start py-2 justify-content-center">
                                <div class="flex-grow-1">
                                    <h6>@Model.UserAddress.FirstName @Model.UserAddress.LastName</h6>
                                    <h6>@Model.UserAddress.Street</h6>
                                    <h6> @Model.UserAddress.PostalCode @Model.UserAddress.City</h6>
                                    <h6 >@Model.UserAddress.PhoneNumber</h6>
                                </div>
                            </label>
                        </div>

                        <div class="col-4 text-start">
                            <h6> Ordrebekreftelse sendes til @User.Identity?.Name</h6>
                        </div>

                    </div>
                </div>
            </div>
        </li>
    </ul>
</section>

<section class="mb-4">
    <h4 class="text-start fw-semibold">Leveringsmetode</h4>
    <ul class="list-group">
        <li class="list-group-item">
            <div class="row">
                <div class="col">
                    <div class="row align-items-center py-2">
                        <div class="col-6">
                            <div class="col-6 d-flex align-items-center">
                                <h6 class="m-0">@Model.ShippingMethod?.MethodName</h6>
                            </div>
                        </div>
                        
                        <div class="col-6 d-flex justify-content-end align-items-center">
                            <h6 class="m-0">@Pricing.Money(Model.ShippingPrice)</h6>
                        </div>
                    </div>
                </div>
            </div>
        </li>
    </ul>
</section>



<script>
    // When page is loaded
    document.addEventListener("DOMContentLoaded", function () {
        if (typeof Summary === "function") {
            Summary();
        }
    });
</script>